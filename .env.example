# OLAP BI Platform — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic API key for intent classification and narrative generation
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional (backend) ────────────────────────────────────────────────────────
# DuckDB database file path (relative to backend/ directory)
DATABASE_PATH=data/olap.duckdb

# LLM model to use (claude-3-haiku is fast and cost-effective)
LLM_MODEL=claude-3-haiku-20240307

# CORS allowed origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Session TTL in minutes
SESSION_TTL_MINUTES=30

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
